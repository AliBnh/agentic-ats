# ==========================================
# AgenticATS Environment Configuration
# ==========================================

# Groq Cloud API Key (Required for LLM LPU inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
PARSER_MODEL_NAME=qwen/qwen3.8-27b
MODEL_TEMPERATURE=0.0

# PostgreSQL Database Configuration
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=agentic_ats
DATABASE_URL=postgresql://ats_user:ats_password@postgres:5432/agentic_ats

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_agentic_ats_prod_2026_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LangSmith LLM Observability & Tracing (Optional)
# Get your free key at: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-ats
